{
  "name": "telegram-account-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "start:docker": "node dist/db/migrate.js && node dist/db/seed.js && node dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:audit:cleanup": "tsx src/db/cleanup-audit.ts",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:ci": "jest --ci --coverage --runInBand",
    "test:integration": "node scripts/run-integration-tests.mjs",
    "test:integration:container": "jest --config jest.integration.config.cjs --runInBand",
    "test:all": "npm run test:ci && npm run test:integration",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.2",
    "grammy": "^1.34.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "postgres": "^3.4.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@jest/globals": "^30.4.1",
    "@types/node": "^26.2.0",
    "babel-jest": "^30.4.1",
    "drizzle-kit": "^0.31.10",
    "jest": "^30.4.2",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
