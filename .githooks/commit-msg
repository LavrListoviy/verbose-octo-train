#!/bin/sh

commit_message=$(head -n 1 "$1")
pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9][a-z0-9._/-]*\))?(!)?: .+$'

if ! printf '%s\n' "$commit_message" | grep -Eq "$pattern"; then
  echo "Invalid commit message: $commit_message" >&2
  echo "Use Conventional Commits, for example: feat(bot): add registration command" >&2
  exit 1
fi
